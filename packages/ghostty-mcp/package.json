{
  "name": "@gkoreli/ghostty-mcp",
  "version": "0.5.0",
  "description": "CLI and MCP server for observing and controlling Ghostty through its AppleScript API.",
  "type": "module",
  "bin": {
    "ghostty-mcp": "./dist/ghostty-mcp.js"
  },
  "exports": {
    ".": "./dist/ghostty-mcp.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "bun src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun dist/ghostty-mcp.js --help",
    "pack:dry-run": "bun pm pack --dry-run"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkoreli/ghostty-vt-js.git",
    "directory": "packages/ghostty-mcp"
  },
  "homepage": "https://github.com/gkoreli/ghostty-vt-js/tree/main/packages/ghostty-mcp#readme",
  "bugs": {
    "url": "https://github.com/gkoreli/ghostty-vt-js/issues"
  },
  "keywords": [
    "ghostty",
    "mcp",
    "model-context-protocol",
    "terminal",
    "applescript",
    "macos"
  ],
  "license": "MIT",
  "dependencies": {
    "@gkoreli/ghostty-vt-js": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
